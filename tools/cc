#!/bin/sh
# gcc wrapper: force flags that let 2020-era Canon C code build on gcc 15 (C23 defaults).
# Placed in CC so it survives configure.in scripts that overwrite CFLAGS.
exec gcc -fcommon -std=gnu17 \
    -Wno-error \
    -Wno-implicit-function-declaration \
    -Wno-implicit-int \
    -Wno-int-conversion \
    -Wno-incompatible-pointer-types \
    -Wno-return-mismatch \
    "$@"
